FROM python:3.10.12-slim

WORKDIR /app

RUN pip install -U pip
RUN pip install pipenv

COPY ["Pipfile", "Pipfile.lock", "./"]

RUN pipenv install --system --deploy

COPY ["custom_rul_prediction.py", "app.py", "mlruns", "mlflow.db", "./"]

EXPOSE 8002

ENTRYPOINT ["gunicorn", "-k", "uvicorn.workers.UvicornWorker", "--workers", "4", "--bind", "0.0.0.0:8002", "app:app"]